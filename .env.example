# Copy to .env.local and fill from
# ../../../point-taken-biz/api-keys/supabase-point-taken-2026.env
# .env* is gitignored. SUPABASE_SECRET_KEY is full admin and bypasses every RLS
# policy: server-only, never NEXT_PUBLIC_, never in a client component.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Safe to expose. Anon holds no grants on game_events or the append functions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local dev only. Signs the browser in anonymously with no click.
# Refused whenever NODE_ENV=production, so it cannot reach a deploy.
PT_DEV_AUTOLOGIN=1

# Coach. Production and testing key (Steve, 2026-08-23): one key, both jobs.
# Copy from ../../../point-taken-biz/api-keys/claude-api-key.env
# Server-only. Never NEXT_PUBLIC_, never called from a client component.
ANTHROPIC_API_KEY=

# Feedback pop-up destination (Share feedback / Report a bug). The Google
# Form this points at does not exist yet: leave these unset and the pop-up
# still opens and works, it just logs a console warning on send instead of
# delivering anywhere. Once the form exists, copy real values from
# ../../../point-taken-biz/api-keys/ (or wherever Steve files this form's
# ids) into .env.local. All three are safe to expose: they only address a
# public form endpoint, they hold no secret.
NEXT_PUBLIC_FEEDBACK_FORM_ACTION_URL=
# JSON object mapping our field names to the form's entry.<NNNN> ids, e.g.
# {"stage":"entry.111","description":"entry.222","userAgent":"entry.444","category":"entry.555"}
NEXT_PUBLIC_FEEDBACK_FORM_ENTRY_IDS=
# Optional. Link to a longer standalone form. Omit to hide the link entirely.
NEXT_PUBLIC_FEEDBACK_SHARE_MORE_URL=
