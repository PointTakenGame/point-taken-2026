# Copy to .env.local and fill from
# ../../../point-taken-biz/api-keys/supabase-point-taken-2026.env
# .env* is gitignored. SUPABASE_SECRET_KEY is full admin and bypasses every RLS
# policy: server-only, never NEXT_PUBLIC_, never in a client component.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Safe to expose. Anon holds no grants on game_events or the append functions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local dev only. Signs the browser in anonymously with no click.
# Refused whenever NODE_ENV=production, so it cannot reach a deploy.
PT_DEV_AUTOLOGIN=1
